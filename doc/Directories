# ディレクトリ構成
.
├── cmd/
│   └── server/
│       └── main.go       # flag.Parse() での起動設定、ルーターの初期化
├── internal/
│   ├── controller/       # (Handler) Ginのコンテキスト (*gin.Context) を扱う層
│   ├── service/          # ビジネスロジック。DBや外部APIなどの抽象的な操作
│   ├── repository/       # データベースの具体的なCRUD操作
│   ├── model/            # 構造体定義（DBのテーブル定義など）
│   ├── config/           # コンフィグ設定の読み込み
│   └── infrastructure/   # DB接続、Redis、メール送信などの基盤設定
├── pkg/                  # プロジェクト外でも使える汎用ツール
├── api/                  # OpenAPI / Swagger定義ファイル
├── configs/              # 設定ファイル (YAML, .envなど)
├── docs/                 # APIドキュメント
├── go.mod
└── go.sum